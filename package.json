{
  "name": "asean-shipping-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "daily:fetch": "bun scripts/daily-fetch.mjs",
    "daily:refresh": "bun scripts/daily-fetch.mjs",
    "energy:refresh": "bun scripts/energy-lng-refresh.mjs",
    "climate:refresh": "bun scripts/climate-refresh.mjs",
    "climate:test": "bun scripts/climate-tests.mjs",
    "daily:evidence": "bun scripts/daily-evidence.mjs",
    "daily:apply": "bun scripts/daily-apply.mjs",
    "daily:check": "bun scripts/daily-check.mjs",
    "daily:test": "bun scripts/daily-tests.mjs && bun scripts/climate-tests.mjs",
