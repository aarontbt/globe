{
  "name": "asean-shipping-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:runtime": "node --test scripts/runtime-tests.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc -b && vite build",
    "prepreview": "npm run check:runtime",
    "preview": "vite preview",
    "daily:fetch": "bun scripts/daily-fetch.mjs",
    "daily:refresh": "bun scripts/daily-fetch.mjs",
    "energy:refresh": "bun scripts/energy-lng-refresh.mjs",
    "climate:refresh": "bun scripts/climate-refresh.mjs",
    "climate:test": "bun scripts/climate-tests.mjs",
    "weather:refresh": "python3 scripts/weather-refresh.py",
    "weather:test": "python3 scripts/weather-tests.py && bun scripts/weather-contract-tests.ts",
    "daily:snapshot": "python3 scripts/daily-snapshot.py",
    "daily:evidence": "bun scripts/daily-evidence.mjs",
    "typesafe:review": "bun scripts/typesafe-review.mjs",
    "daily:apply": "bun scripts/daily-apply.mjs",
    "daily:check": "bun scripts/daily-check.mjs",
    "daily:test": "bun scripts/daily-tests.mjs && bun scripts/climate-tests.mjs",
    "daily:status": "bun scripts/daily-status.mjs",
    "daily:update": "bun run daily:apply && bun run daily:check && bun run daily:snapshot && bun run build",
    "cyclone:refresh": "python3 scripts/cyclone-refresh.py",
    "cyclone:test": "python3 scripts/cyclone-tests.py && bun scripts/cyclone-contract-tests.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/react": "^9.1.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.5"
  }
}
